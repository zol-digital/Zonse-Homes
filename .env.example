# Local development placeholders only. Do not use these as production credentials.
PROJECT_NAME=Zonse Homes Backend
API_V1_STR=/api/v1
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_local_postgres_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=zonse_homes
ENVIRONMENT=development
REPORT_IP_HASH_SECRET=replace_with_a_random_secret_at_least_32_bytes
# Uvicorn trusts forwarded headers only from these proxy peer IPs.
FORWARDED_ALLOW_IPS=127.0.0.1
FEATURED_PAYMENT_WEBHOOK_SECRET=replace_with_a_random_secret_at_least_32_bytes
SESSION_COOKIE_NAME=zonse_session
SESSION_LIFETIME_SECONDS=86400
SESSION_COOKIE_SAMESITE=lax
SESSION_CSRF_TRUSTED_ORIGINS=
UPLOAD_DIR=/app/uploads
MAX_IMAGE_UPLOAD_BYTES=10485760
